{
  "openapi": "3.0.0",
  "info": {
    "title": "ReservaLab API",
    "version": "1.0.0",
    "description": "API REST para a plataforma ReservaLab - Sistema centralizado de reservas e controle de empréstimos acadêmicos/corporativos"
  },
  "servers": [
    {
      "url": "http://localhost:3333",
      "description": "Servidor Local de Desenvolvimento"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Healthcheck da API",
        "description": "Retorna o status operacional da API e timestamp",
        "responses": {
          "200": {
            "description": "API operando normalmente",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "example": "ok" },
                    "service": { "type": "string", "example": "ReservaLab API" },
                    "timestamp": { "type": "string", "example": "2026-11-04T23:45:00.000Z" }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
