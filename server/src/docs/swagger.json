{
  "openapi": "3.0.0",
  "info": {
    "title": "ReservaLab API",
    "version": "1.0.0",
    "description": "API REST para a plataforma ReservaLab - Sistema centralizado de reservas e controle de empréstimos acadêmicos/corporativos"
  },
  "servers": [
    {
      "url": "http://localhost:3333",
      "description": "Servidor Local de Desenvolvimento"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Healthcheck da API",
        "responses": { "200": { "description": "API operando normalmente" } }
      }
    },
    "/api/auth/register": {
      "post": {
        "tags": ["Autenticação"],
        "summary": "Cadastro de novo usuário",
        "responses": { "201": { "description": "Usuário cadastrado com sucesso" }, "409": { "description": "E-mail já cadastrado" } }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": ["Autenticação"],
        "summary": "Login de usuário",
        "responses": { "200": { "description": "Token JWT gerado" }, "401": { "description": "Credenciais inválidas" } }
      }
    },
    "/api/auth/me": {
      "get": {
        "tags": ["Autenticação"],
        "summary": "Perfil do usuário logado e cálculo do status dinâmico",
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "Dados do usuário com dynamic_status" } }
      }
    },
    "/api/categories": {
      "get": {
        "tags": ["Catálogo"],
        "summary": "Listar categorias ativas",
        "responses": { "200": { "description": "Lista de categorias" } }
      }
    },
    "/api/items": {
      "get": {
        "tags": ["Catálogo"],
        "summary": "Listar equipamentos ativos com filtro de período e disponibilidade",
        "responses": { "200": { "description": "Lista de itens com status de disponibilidade" } }
      }
    },
    "/api/reservations": {
      "post": {
        "tags": ["Reservas"],
        "summary": "Criar reserva direta (sem aprovação manual)",
        "security": [{ "bearerAuth": [] }],
        "responses": { "201": { "description": "Reserva agendada" }, "409": { "description": "Conflito de agenda" } }
      }
    },
    "/api/reservations/my-reservations": {
      "get": {
        "tags": ["Reservas"],
        "summary": "Histórico de reservas do próprio usuário",
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "Lista de reservas próprias" } }
      }
    },
    "/api/reservations/{id}/cancel": {
      "patch": {
        "tags": ["Reservas"],
        "summary": "Cancelar reserva própria agendada",
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "Reserva cancelada" } }
      }
    },
    "/api/admin/categories": {
      "get": {
        "tags": ["Admin - Categorias"],
        "summary": "Listar categorias com contagem de itens",
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "Lista de categorias" } }
      },
      "post": {
        "tags": ["Admin - Categorias"],
        "summary": "Criar categoria",
        "security": [{ "bearerAuth": [] }],
        "responses": { "201": { "description": "Categoria criada" } }
      }
    },
    "/api/admin/categories/{id}": {
      "put": {
        "tags": ["Admin - Categorias"],
        "summary": "Atualizar categoria",
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "Categoria atualizada" } }
      },
      "delete": {
        "tags": ["Admin - Categorias"],
        "summary": "Excluir categoria",
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "Categoria removida" }, "400": { "description": "Categoria possui itens vinculados" } }
      }
    },
    "/api/admin/items": {
      "get": {
        "tags": ["Admin - Equipamentos"],
        "summary": "Listar todos os equipamentos e manutenções",
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "Lista de equipamentos" } }
      },
      "post": {
        "tags": ["Admin - Equipamentos"],
        "summary": "Cadastrar equipamento com patrimônio único",
        "security": [{ "bearerAuth": [] }],
        "responses": { "201": { "description": "Equipamento cadastrado" }, "409": { "description": "Patrimônio duplicado" } }
      }
    },
    "/api/admin/items/{id}": {
      "put": {
        "tags": ["Admin - Equipamentos"],
        "summary": "Atualizar dados do equipamento",
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "Equipamento atualizado" } }
      }
    },
    "/api/admin/items/{id}/status": {
      "patch": {
        "tags": ["Admin - Equipamentos"],
        "summary": "Alternar status ativo/inativo",
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "Status alterado" } }
      }
    },
    "/api/admin/items/{id}/maintenance": {
      "post": {
        "tags": ["Admin - Manutenção"],
        "summary": "Enviar equipamento para manutenção",
        "security": [{ "bearerAuth": [] }],
        "responses": { "201": { "description": "Manutenção registrada" }, "400": { "description": "Item possui empréstimo ativo" } }
      }
    },
    "/api/admin/maintenance/{id}/conclude": {
      "patch": {
        "tags": ["Admin - Manutenção"],
        "summary": "Concluir manutenção de equipamento",
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "Manutenção finalizada" } }
      }
    },
    "/api/admin/dashboard/daily-pickups": {
      "get": {
        "tags": ["Admin - Painel Operacional"],
        "summary": "Listar retiradas previstas do dia",
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "Lista de retiradas agendadas" } }
      }
    },
    "/api/admin/loans/pickup": {
      "post": {
        "tags": ["Admin - Painel Operacional"],
        "summary": "Confirmar retirada física (criação de Loan)",
        "security": [{ "bearerAuth": [] }],
        "responses": { "201": { "description": "Empréstimo ativado" } }
      }
    },
    "/api/admin/reservations/{id}/no-show": {
      "patch": {
        "tags": ["Admin - Painel Operacional"],
        "summary": "Registrar não comparecimento do solicitante",
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "Status alterado para NO_SHOW" } }
      }
    },
    "/api/admin/dashboard/daily-returns": {
      "get": {
        "tags": ["Admin - Painel Operacional"],
        "summary": "Listar devoluções do dia e empréstimos ativos",
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "Lista de devoluções pendentes" } }
      }
    },
    "/api/admin/loans/{id}/return": {
      "post": {
        "tags": ["Admin - Painel Operacional"],
        "summary": "Registrar devolução de empréstimo com observação de avaria",
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "Devolução concluída e status COMPLETED" } }
      }
    },
    "/api/admin/settings": {
      "get": {
        "tags": ["Admin - Regras"],
        "summary": "Consultar parâmetros globais do sistema",
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "Configurações atuais" } }
      },
      "put": {
        "tags": ["Admin - Regras"],
        "summary": "Atualizar max_rent_days e max_concurrent_items",
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "Configurações atualizadas" } }
      }
    },
    "/api/admin/users": {
      "get": {
        "tags": ["Admin - Usuários"],
        "summary": "Listar usuários com cálculo de status dinâmico",
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "Lista de usuários com status" } }
      }
    },
    "/api/admin/users/{id}/toggle-block": {
      "patch": {
        "tags": ["Admin - Usuários"],
        "summary": "Alternar bloqueio manual do usuário",
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "Status de bloqueio atualizado" } }
      }
    },
    "/api/admin/loans/history": {
      "get": {
        "tags": ["Admin - Histórico"],
        "summary": "Histórico geral consolidado de empréstimos e devoluções",
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "Histórico completo" } }
      }
    }
  }
}
