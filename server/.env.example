PORT=3333

# Transaction pooler (porta 6543) usado pela aplicação.
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@[POOLER_HOST]:6543/postgres?pgbouncer=true"

# Session pooler (porta 5432) usado pelas migrações do Prisma.
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@[POOLER_HOST]:5432/postgres"

# Gere localmente com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="[GENERATE_A_RANDOM_SECRET]"
JWT_EXPIRES_IN="7d"
